<!-- 归档页，展示本站所有文章，按照年份降序归类，url形式：https://yoursite/archives/ -->

<!-- last: 按年份把文章分组，当前遍历到的年份 -->
<!-- now: 当前遍历到的文章的发布年份 -->

<div class="container archives">
  <div class="post-list">
    <%
      var last = null;
      var now = null;
    %>
    <%
      site.posts.sort('date', -1).each(function(item, index) {
    %>
      <%
        // Use the date() helper, not item.date.year()/format(): post dates are moments in
        // the build machine's local time, and only date() applies config.timezone.
        if (index === 0) {
          last = date(item.date, "YYYY");
      %>
        <!-- 第一篇文章的发布年份呈现 -->
        <div class="content-title">
          <h2>
            <span><%- last %></span>
          </h2>
        </div>
      <%
        }
        now = date(item.date, "YYYY");
        if (now !== last) {
          last = now;
      %>
        <!-- 后续文章的发布年份呈现 -->
        <div class="content-title">
          <h2>
            <span><%- now %></span>
          </h2>
        </div>
      <%
        }
      %>
      <div class="post-item" title="<%- item.title %>">
        <div class="time-m-d"><%- date(item.date, "MM-DD") %></div>
        <div class="title">
          <a href="<%- url_for(item.path) %>">
            <span><%- item.title %></span>
          </a>
        </div>
      </div>
    <%
      });
    %>
  </div>
</div>
